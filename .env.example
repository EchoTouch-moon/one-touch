# Copy to .env and fill in real values. Every variable is prefixed ONETOUCH_;
# the old GLM_WORDS_* names still work but log a deprecation warning.
ONETOUCH_ADMIN_USERNAME=admin
ONETOUCH_ADMIN_PASSWORD=change-this-password
ONETOUCH_AUTH_SECRET=change-this-secret-to-a-long-random-string

ONETOUCH_LLM_PROVIDER=ollama
ONETOUCH_LLM_MODEL=llama3
ONETOUCH_LLM_BASE_URL=http://host.docker.internal:11434/v1
ONETOUCH_LLM_API_KEY=
ONETOUCH_OPENAI_API_KEY=
ONETOUCH_ANTHROPIC_API_KEY=
ONETOUCH_DOUBAO_API_KEY=
